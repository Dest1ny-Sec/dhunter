# Binaries / build output
/bin/
# dist/ is too broad — it ignores frontend/dist which IS committed.
# (Go server falls back to "API only" without it.)
# dist/

# Runtime data (SQLite DB, WAL, SHM)
data/*.db
data/*.db-wal
data/*.db-shm

# Secrets / local state
.dhunter.tokens
.env
.env.local

# Frontend
frontend/node_modules/
# frontend/dist/ is COMMITTED to the repo so users can install without Node.js.
# (Go server falls back to "API only" without it.) Run `cd frontend && npm run
# build` to refresh after editing frontend sources.
# frontend/dist/

# Python
agents/.venv/
__pycache__/
*.pyc
*.egg-info/

# Logs / temp
/tmp/
nohup.out
*.log

# OS
.DS_Store

# runtime logs (agent.log / errors.log)
logs/

# playwright-mcp test artifacts
.playwright-mcp/
